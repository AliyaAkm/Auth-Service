HTTP_ADDR=:8080

DB_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db
DB_SSLMODE=disable

JWT_SECRET=replace-with-long-random-secret
JWT_ISSUER=auth-service
JWT_AUDIENCE=edu-platform
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Zerde Study
SMTP_PASSWORD_RESET_SUBJECT=Password reset code

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/auth/google/callback

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_OAUTH_REDIRECT_URL=http://localhost:3000/auth/github/callback

